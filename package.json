{
	"name": "obsidian-abc-blocks",
	"version": "1.1.0",
	"description": "Editable ABC notation blocks for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:abc-normalize": "node scripts/check-abc-normalize.mjs",
		"test:abc-empty-shell": "node scripts/check-abc-empty-shell.mjs",
		"test:abc-invalid-fallback": "node scripts/check-abc-invalid-fallback.mjs",
		"test:roundtrip": "node scripts/check-abc-roundtrip.mjs",
		"test:abc-block-patch": "node scripts/check-abc-block-patch.mjs",
		"test:abc-sync-debounce": "node scripts/check-abc-sync-debounce.mjs",
		"test:abc-first-edit": "node scripts/check-abc-first-edit.mjs",
		"test:phase-4.5": "node scripts/check-abc-multi-block-lp.mjs",
		"test:editor-toolbar": "node scripts/check-editor-toolbar.mjs",
		"test:staff-placement": "node scripts/check-staff-placement.mjs",
		"test:note-delete": "node scripts/check-note-delete.mjs",
		"test:duration-on-selection": "node scripts/check-duration-on-selection.mjs",
		"test:rest-placement": "node scripts/check-rest-placement.mjs",
		"test:key-time-controls": "node scripts/check-key-time-controls.mjs",
		"test:all": "npm run test:abc-normalize && npm run test:abc-empty-shell && npm run test:abc-invalid-fallback && npm run test:roundtrip && npm run test:abc-block-patch && npm run test:abc-sync-debounce && npm run test:abc-first-edit && npm run test:phase-4.5 && npm run test:editor-toolbar && npm run test:staff-placement && npm run test:note-delete && npm run test:duration-on-selection && npm run test:rest-placement && npm run test:key-time-controls",
		"sync:test-note": "node scripts/sync-test-note-to-vault.mjs",
		"verify:test-note": "node scripts/verify-test-note.mjs",
		"compare:phase-4.5-probe": "node scripts/compare-phase-45-probe.mjs",
		"wait:phase-4.5-probe": "node scripts/wait-and-compare-probe.mjs",
		"cycle:phase-4.5": "node scripts/run-phase-45-cycle.mjs",
		"iterate:phase-4.5": "bash scripts/iterate-phase-4.5.sh"
	},
	"keywords": [
		"obsidian",
		"music",
		"abc",
		"notation"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.10.2",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"abcjs": "^6.6.3"
	}
}
