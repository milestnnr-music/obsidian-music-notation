{
	"name": "obsidian-abc-blocks",
	"version": "0.1.1",
	"description": "Editable ABC notation blocks for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:abc-normalize": "node scripts/check-abc-normalize.mjs",
		"test:abc-empty-shell": "node scripts/check-abc-empty-shell.mjs",
		"test:roundtrip": "node scripts/check-abc-roundtrip.mjs",
		"test:abc-block-patch": "node scripts/check-abc-block-patch.mjs",
		"test:abc-sync-debounce": "node scripts/check-abc-sync-debounce.mjs",
		"test:abc-first-edit": "node scripts/check-abc-first-edit.mjs"
	},
	"keywords": [
		"obsidian",
		"music",
		"abc",
		"notation"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.10.2",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"abcjs": "^6.6.3"
	}
}
